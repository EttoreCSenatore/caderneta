# Copie para .env e preencha. NUNCA versione o .env.
# Segredos: `sh gerar-segredos.sh` imprime valores novos para colar aqui.

# --- Banco (senhas fortes e diferentes) ---
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Endereço e HTTPS ---
CADERNETA_DOMAIN=caderneta.suaescola.com.br
CADERNETA_ACME_EMAIL=ti@suaescola.com.br
CADERNETA_PUBLIC_URL=https://caderneta.suaescola.com.br
# portas publicadas (80 e 443 em produção)
HTTP_PORT=80
HTTPS_PORT=443

# --- Modo produção: exige chave de dados, antivírus e cookie seguro ---
CADERNETA_ENV=prod
CADERNETA_COOKIE_SECURE=true
CADERNETA_ANTIVIRUS=clamav
CADERNETA_STORAGE_DIR=/data/storage
CADERNETA_DATA_KEY=
# Rotação de chave: a antiga vai aqui (veja a documentação "Backups, chaves e logs")
CADERNETA_DATA_KEYS_ANTIGAS=

# --- Quem opera esta instalação (aparece na política de privacidade e nos termos) ---
CADERNETA_OPERADORA_NOME=
CADERNETA_OPERADORA_CONTATO=
# Textos legais próprios do advogado (coloque privacidade.md e termos.md em deploy/legal): descomente
# CADERNETA_LEGAL_DIR=/legal

# --- E-mail (SMTP do provedor escolhido) ---
CADERNETA_SMTP_HOST=
CADERNETA_SMTP_PORT=587
CADERNETA_SMTP_USER=
CADERNETA_SMTP_PASSWORD=
CADERNETA_SMTP_STARTTLS=true
CADERNETA_MAIL_FROM=Caderneta <nao-responda@suaescola.com.br>

# --- Push (opcional): python -m app.cli gerar-vapid ---
CADERNETA_VAPID_PRIVATE_KEY=
CADERNETA_VAPID_PUBLIC_KEY=
CADERNETA_VAPID_SUBJECT=mailto:privacidade@suaescola.com.br
