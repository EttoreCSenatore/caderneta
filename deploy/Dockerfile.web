# App web (build do Vite) servido pelo Caddy, que também faz o HTTPS e proxy da /api.
FROM node:24-alpine AS build
WORKDIR /w
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /w/dist /srv
